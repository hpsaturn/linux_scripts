#!/bin/bash

# Simple version using the first available service
ip=$(curl -s https://api.ipify.org || \
     curl -s https://icanhazip.com || \
     curl -s https://ifconfig.me/ip || \
     wget -qO- https://checkip.amazonaws.com 2>/dev/null)

# Clean up the response and validate
ip_clean=$(echo "$ip" | tr -cd '[:digit:].')
if [[ $ip_clean =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "Public IP: $ip_clean"
else
    echo "Failed to retrieve public IP"
    exit 1
fi
